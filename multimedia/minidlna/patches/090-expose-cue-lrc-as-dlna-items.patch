+static int64_t
+GetTextMetadata(const char *path, const char *name)
+{
+	struct stat file;
+	int64_t ret;
+
+	if( stat(path, &file) != 0 )
+		return 0;
+
+	ret = sql_exec(db, "INSERT into DETAILS"
+	                   " (TITLE, PATH, SIZE, TIMESTAMP, MIME) "
+	                   "VALUES"
+	                   " ('%q', %Q, %lld, %lld, 'text/plain');",
+	                   name, path, (long long)file.st_size, (long long)file.st_mtime);
+	if( ret != SQLITE_OK )
+		return 0;
+
+	return sqlite3_last_insert_rowid(db);
+}
