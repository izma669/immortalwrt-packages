+static const char *
+get_text_ext(const char *id)
+{
+	static char ext[8];
+	char *path;
+	const char *dot;
+	char *p;
+	long long detail_id;
+
+	strcpy(ext, "txt");
+	detail_id = strtoll(id, NULL, 10);
+	path = sql_get_text_field(db, "SELECT PATH from DETAILS where ID = '%lld'", detail_id);
+	if( path )
+	{
+		dot = strrchr(path, '.');
+		if( dot && dot[1] && strlen(dot + 1) < sizeof(ext) )
+		{
+			strcpy(ext, dot + 1);
+			for( p = ext; *p; p++ )
+				*p = tolower(*p);
+		}
+		sqlite3_free(path);
+	}
+	return ext;
+}
